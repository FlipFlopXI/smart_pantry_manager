<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/help_dialog_background"
    android:orientation="vertical"
    android:padding="22dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/help_icon" android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/recent_icon" android:gravity="center" android:textSize="26sp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="QUICK GUIDE" android:textColor="@color/green" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12"/>
            <TextView android:id="@+id/help_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/ink" android:textSize="22sp" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/help_close" android:layout_width="42dp" android:layout_height="42dp" android:contentDescription="Close help" android:gravity="center" android:text="×" android:textColor="@color/muted" android:textSize="28sp"/>
    </LinearLayout>
    <TextView android:id="@+id/help_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textColor="@color/ink" android:textSize="16sp" android:lineSpacingExtra="3dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/recent_icon" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="💡" android:textSize="20sp"/>
        <TextView android:id="@+id/help_tip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textColor="@color/deep_green" android:textSize="14sp" android:lineSpacingExtra="2dp"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/help_done" style="@style/SoftActionButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="22dp" android:text="Got it"/>
</LinearLayout>
