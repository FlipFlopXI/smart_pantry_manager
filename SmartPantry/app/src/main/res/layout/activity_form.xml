<com.smartpantry.manager.views.WheelScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/back" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:text="‹ Back to pantry" android:textColor="@color/green" android:textSize="16sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="YOUR PANTRY" android:textColor="@color/green" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.12"/>
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/ink"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Keep your kitchen shelf up to date." android:textColor="@color/muted" android:textSize="14sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="17dp" android:orientation="vertical" android:background="@drawable/card" android:elevation="2dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ingredient details" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold"/>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/name_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:hint="Ingredient name" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/input_stroke" app:boxCornerRadiusTopStart="15dp" app:boxCornerRadiusTopEnd="15dp" app:boxCornerRadiusBottomStart="15dp" app:boxCornerRadiusBottomEnd="15dp"><com.google.android.material.textfield.TextInputEditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords"/></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/quantity_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Quantity" app:boxBackgroundMode="outline" app:boxBackgroundColor="@color/white" app:boxStrokeColor="@color/input_stroke" app:boxCornerRadiusTopStart="15dp" app:boxCornerRadiusTopEnd="15dp" app:boxCornerRadiusBottomStart="15dp" app:boxCornerRadiusBottomEnd="15dp"><com.google.android.material.textfield.TextInputEditText android:id="@+id/quantity" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal"/></com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="Unit" android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold"/>
            <Spinner android:id="@+id/unit" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:paddingStart="12dp" android:background="@drawable/card"/>
            <TextView android:id="@+id/unit_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="Select a unit" android:textColor="@color/jar_red" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:padding="17dp" android:orientation="vertical" android:background="@drawable/card" android:elevation="2dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Expiry date" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Optional, but handy for reducing waste" android:textColor="@color/muted" android:textSize="13sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:padding="13dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/recent_icon">
                <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="📅" android:textSize="22sp"/>
                <TextView android:id="@+id/expiry_value" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="No expiry date selected" android:textColor="@color/deep_green" android:textSize="15sp" android:textStyle="bold"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/expiry" style="@style/SoftActionButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp" android:text="Choose date"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/clear_expiry" style="@style/SoftActionButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:text="Clear date" android:textSize="14sp"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/save" style="@style/SoftActionButton" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="21dp" android:text="Save ingredient"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/cancel" style="@style/SoftActionButton" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="7dp" android:layout_marginBottom="15dp" android:text="Cancel"/>
    </LinearLayout>
</com.smartpantry.manager.views.WheelScrollView>
