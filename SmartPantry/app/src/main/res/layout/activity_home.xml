<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/cream">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="28dp">
            <ImageView android:id="@+id/home_logo" android:layout_width="210dp" android:layout_height="210dp" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp" android:contentDescription="The Smart Pantry logo" android:scaleType="fitCenter" android:src="@drawable/home_logo"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="-14dp" android:gravity="center" android:text="Turn what you have into something delicious." android:textColor="@color/muted" android:textSize="15sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Your kitchen at a glance" android:textColor="@color/ink" android:textSize="21sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Little jars, big possibilities" android:textColor="@color/muted" android:textSize="13sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <com.smartpantry.manager.views.CookieJarStatView android:id="@+id/jar_pantry" android:layout_width="0dp" android:layout_height="183dp" android:layout_weight="1"/>
                <com.smartpantry.manager.views.CookieJarStatView android:id="@+id/jar_recipes" android:layout_width="0dp" android:layout_height="183dp" android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.smartpantry.manager.views.CookieJarStatView android:id="@+id/jar_soon" android:layout_width="0dp" android:layout_height="183dp" android:layout_weight="1"/>
                <com.smartpantry.manager.views.CookieJarStatView android:id="@+id/jar_expired" android:layout_width="0dp" android:layout_height="183dp" android:layout_weight="1"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="What would you like to do?" android:textColor="@color/ink" android:textSize="21sp" android:textStyle="bold"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/add" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="13dp" android:gravity="center_vertical|start" android:paddingStart="22dp" android:text="＋  Add ingredient" android:textAllCaps="false" android:textColor="@color/deep_green" android:textSize="16sp" app:backgroundTint="@color/action_green" app:cornerRadius="20dp" app:strokeColor="@color/soft_green_outline" app:strokeWidth="1dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/pantry" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:gravity="center_vertical|start" android:paddingStart="22dp" android:text="🥕  Open pantry" android:textAllCaps="false" android:textColor="@color/deep_green" android:textSize="16sp" app:backgroundTint="@color/action_green" app:cornerRadius="20dp" app:strokeColor="@color/soft_green_outline" app:strokeWidth="1dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/recipes" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:gravity="center_vertical|start" android:paddingStart="22dp" android:text="🍳  Suggested recipes" android:textAllCaps="false" android:textColor="@color/deep_green" android:textSize="16sp" app:backgroundTint="@color/action_green" app:cornerRadius="20dp" app:strokeColor="@color/soft_green_outline" app:strokeWidth="1dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="Recently cooked" android:textColor="@color/ink" android:textSize="21sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Your latest five kitchen wins" android:textColor="@color/muted" android:textSize="13sp"/>
            <TextView android:id="@+id/recent_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:padding="20dp" android:background="@drawable/recent_card" android:text="Nothing cooked yet. Open a recipe and mark it as cooked to keep it here. 🍪" android:textColor="@color/muted" android:textSize="14sp"/>
            <LinearLayout android:id="@+id/recent_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical"/>
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white" app:menu="@menu/bottom_nav" app:labelVisibilityMode="labeled"/>
</LinearLayout>
