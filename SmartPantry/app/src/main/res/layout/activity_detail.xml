<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/back" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:text="‹ Back to recipes" android:textColor="@color/green" android:textSize="18sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="🍽️" android:textSize="55sp"/>
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="27sp" android:textStyle="bold" android:textColor="@color/ink"/>
    <TextView android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="16sp" android:textColor="@color/muted"/>
    <TextView android:id="@+id/ingredients" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="18dp" android:background="@drawable/card" android:textColor="@color/ink" android:textSize="17sp"/>
    <TextView android:id="@+id/instructions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="18dp" android:background="@drawable/card" android:textColor="@color/ink" android:textSize="17sp"/>
</LinearLayout></ScrollView>
